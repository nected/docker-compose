# generic oidc sso (CyberArk, Okta, Keycloak, Ping etc.)
OIDC_AUTH_ENABLED=false
# discovery doc is read from {OIDC_ISSUER_URL}/.well-known/openid-configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# keep empty for public client (PKCE only)
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# optional, claim to read email from if not in email/preferred_username/upn
OIDC_EMAIL_CLAIM=
OIDC_REQUIRE_VERIFIED_EMAIL=false
# label & icon of login button
OIDC_DISPLAY_NAME=SSO
OIDC_ICON_URL=

